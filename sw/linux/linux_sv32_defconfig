# ============================================================================
# sw/linux/linux_sv32_defconfig — Linux v6.6 LTS RV32IMA + Sv32 最小内核配置片段
# ----------------------------------------------------------------------------
# 用法 (在 Linux / WSL2 内核源码树中):
#   make ARCH=riscv CROSS_COMPILE=riscv32-unknown-linux-gnu- rv32_defconfig
#   scripts/kconfig/merge_config.sh -m .config /path/to/linux_sv32_defconfig
#   make ARCH=riscv CROSS_COMPILE=riscv32-unknown-linux-gnu- olddefconfig
# ============================================================================

# 目标架构: RV32IMA + Sv32 MMU (关闭 FPU 与压缩指令 C 扩展, 严格匹配硬件 ISA)
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y

# 中断与定时器: 标准 CLINT (SBI timer) + SiFive PLIC Context 1 (S-mode)
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# 串口控制台: NS16550A (reg-shift=2, reg-io-width=4) + earlycon=sbi
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# 根文件系统: 内嵌 cpio initramfs + tmpfs + devtmpfs + proc/sysfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# 裁剪非必要子系统以加速 100 MHz FPGA 启动 (< 10 秒进 Shell)
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_PCI=n
CONFIG_DEBUG_INFO=n
